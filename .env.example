# All services bind to localhost. No real credentials are needed for the deterministic demo.
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
MCP_BASE_URL=http://127.0.0.1:8788/mcp
MODEL_BASE_URL=http://127.0.0.1:8789/v1
DASHBOARD_PORT=4173
BOUNTY_FEED_MODE=live

# Optional: configure a real model in TrueForge manually instead of the deterministic demo model.
# Never commit the value.
OPENAI_API_KEY=

# Intentionally absent: wallet keys, payment keys, signing keys, and submission credentials.
